{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers에 올릴 때 실제로 실행되는 진입점입니다. OpenNext가
  // `npm run cf:build`(opennextjs-cloudflare build) 실행 시 .open-next/ 아래에
  // 만들어주므로, 이 파일 자체를 직접 손댈 일은 거의 없습니다.
  "main": ".open-next/worker.js",
  "name": "moving-advisor",
  // 배포한 뒤 Cloudflare 대시보드 어디서든 이 이름으로 워커를 찾을 수 있습니다.
  // 다른 이름을 쓰고 싶다면 이 값만 바꾸면 됩니다(대시보드에 이미 같은 이름의
  // 워커가 있으면 그 워커가 업데이트됩니다).
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    // Node.js API(process.env, undici 등 이 프로젝트가 실제로 쓰는 것들)를 Workers
    // 런타임에서 흉내내 주는 필수 플래그입니다 — 이게 없으면 API 라우트(lib/molit.js
    // 등)가 동작하지 않습니다.
    "nodejs_compat",
    // Workers의 fetch가 사설 IP·localhost 등으로는 나가지 못하게 막는 옵션입니다.
    // 이 앱이 호출하는 국토부·LH·청약홈 API는 전부 공인 인터넷 호스트라 문제 없습니다.
    "global_fetch_strictly_public",
    // *** 실제 배포에서 API 호출이 전부 "ReferenceError: WeakRef is not defined"로
    // 실패하던 문제의 진짜 원인이자 해결책입니다(README 31번) ***. Cloudflare
    // Workers 런타임은 기본적으로 WeakRef/FinalizationRegistry라는 JS 표준 내장
    // 기능 자체를 지원하지 않는데, Node의 fetch 구현체(undici, 그리고 Next.js가
    // 내부적으로 감싸는 fetch)가 커넥션 재사용 등에 이 기능을 쓰고 있어서, 이 두
    // 내장 기능을 쓰는 코드가 실행되는 순간(=외부 API를 실제로 호출하는 순간) 항상
    // 이 오류로 죽었습니다. 로컬 `wrangler dev --local`은 실제 Node.js 위에서
    // 돌아가는 시뮬레이션이라 이 문제가 안 보였고, 진짜 배포(그리고 `wrangler dev`의
    // 원격 미리보기 모드)에서만 드러나서 찾기 오래 걸렸습니다. 이 플래그를 켜면
    // Workers 런타임이 WeakRef/FinalizationRegistry를 지원하게 되어 문제가
    // 해결됩니다(2025-05-05 이후 compatibility_date는 기본으로 켜져 있지만,
    // 위 compatibility_date 값과 무관하게 항상 켜지도록 명시적으로도 추가했습니다).
    "enable_weak_ref"
  ],
  // 빌드된 정적 파일(Next.js가 만드는 JS/CSS 청크, /geo/*.json 등 public/ 파일)을
  // Workers Assets로 그대로 서빙합니다.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
