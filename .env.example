# 국토교통부 "아파트매매 실거래자료" API 서비스키 (data.go.kr에서 발급, 무료)
# 설정하지 않으면 lib/districts.js의 조사된 참고 가격으로 자동 폴백합니다.
MOLIT_SERVICE_KEY=

# (선택, 기본 꺼짐) 회사/기관 네트워크나 백신 소프트웨어의 "TLS 검사(SSL inspection)"
# 때문에 국토부 API 요청이 "fetch failed"(원인: SELF_SIGNED_CERT_IN_CHAIN 등)로 계속
# 실패하는 경우에만 1로 설정하세요. 국토부 API 요청에 한해서만 인증서 검증을 건너뜁니다
# (다른 기능에는 영향 없음). 더 안전한 해결책은 README 13-1의 NODE_EXTRA_CA_CERTS
# 방법입니다 — 신뢰할 수 없는 네트워크(공용 와이파이 등)에서는 이 값을 켜지 마세요.
# MOLIT_ALLOW_INSECURE_TLS=1

# (선택) 마이홈포털 "공공임대주택 단지정보 조회 서비스" API 인증키 (data.go.kr 15058476,
# 무료). 설정하면 각 지역의 LH·지자체 공공임대주택(국민임대·영구임대·행복주택 등) 단지
# 목록이 함께 표시됩니다. 설정하지 않으면 이 부분만 조용히 표시되지 않습니다(다른 기능에는
# 영향 없음). README 22번 참고.
MYHOME_SERVICE_KEY=

# (선택) LH 청약센터 "공지사항 목록 조회 서비스" API 인증키 (data.go.kr 15058222, 무료).
# 설정하면 지역명이 제목에 포함된 LH 공지사항(모집공고 등)이 함께 표시됩니다. 지역코드가
# 아니라 제목 키워드로만 검색되는 API라 0건이 나오는 경우도 정상입니다. README 22번 참고.
LH_NOTICE_SERVICE_KEY=

# (선택) 한국부동산원 "청약홈 분양정보 조회 서비스" API 인증키 (data.go.kr 15098547, 무료).
# 설정하면 해당 시/도의 진행 중/최근 아파트 청약 공고(APT 유형만, 공공분양·신혼희망타운
# 포함)가 함께 표시됩니다. 오피스텔/무순위/민간임대/임의공급은 필드 스키마를 문서로 확인하지
# 못해 의도적으로 포함하지 않았습니다. README 22번 참고.
APPLYHOME_SERVICE_KEY=
